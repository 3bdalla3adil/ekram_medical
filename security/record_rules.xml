<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Lab Technician: can only write on in_progress requests -->
        <record id="rule_lab_request_lab_tech" model="ir.rule">
            <field name="name">Lab Tech: See all lab requests</field>
            <field name="model_id" ref="model_medical_lab_request"/>
            <field name="groups" eval="[(4, ref('ekram_medical.group_medical_lab'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Reception: sees all records -->
        <record id="rule_appointment_reception" model="ir.rule">
            <field name="name">Reception: All appointments</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('ekram_medical.group_medical_reception'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>