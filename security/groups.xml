<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Category -->
        <record id="module_category_medical" model="ir.module.category">
            <field name="name">Medical Center</field>
            <field name="sequence">20</field>
        </record>

        <!-- Administrator -->
        <record id="group_medical_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_medical"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Full access to all medical records, configuration, and financial reports.</field>
        </record>

        <!-- Reception -->
        <record id="group_medical_reception" model="res.groups">
            <field name="name">Reception</field>
            <field name="category_id" ref="module_category_medical"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Manages patients, appointments, lab requests, invoices, and payments.</field>
        </record>

        <!-- Lab Technician -->
        <record id="group_medical_lab" model="res.groups">
            <field name="name">Lab Technician</field>
            <field name="category_id" ref="module_category_medical"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Processes lab requests and enters/validates results.</field>
        </record>
    </data>
</odoo>