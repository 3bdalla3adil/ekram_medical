<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Form View ── -->
        <record id="view_medical_lab_template_form" model="ir.ui.view">
            <field name="name">medical.lab.template.form</field>
            <field name="model">medical.lab.template</field>
            <field name="arch" type="xml">
                <form string="قالب مختبر / Lab Template">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_template_lines"
                                    class="oe_stat_button" icon="fa-list">
                                <field name="line_count" widget="statinfo" string="المعامل / Parameters"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="اسم الفحص / Investigation Name..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="product_id"/>
                                <field name="department"/>
                            </group>
                            <group>
                                <field name="sample_type"/>
                                <field name="turnaround_hours"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="notes" placeholder="ملاحظات / Notes..."/>
                        <notebook>
                            <page string="المعامل / Parameters" name="parameters">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="test_name" string="اسم الفحص / Test Name"/>
                                        <field name="unit" string="الوحدة / Unit"/>
                                        <field name="normal_range_text" string="النطاق المرجعي / Reference Range"/>
                                        <field name="normal_min" string="الحد الأدنى / Normal Min"/>
                                        <field name="normal_max" string="الحد الأقصى / Normal Max"/>
                                        <field name="result_type" string="نوع النتيجة / Result Type"/>
                                        <field name="notes" string="ملاحظات / Notes"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ── List View ── -->
        <record id="view_medical_lab_template_list" model="ir.ui.view">
            <field name="name">medical.lab.template.list</field>
            <field name="model">medical.lab.template</field>
            <field name="arch" type="xml">
                <list string="قوالب المختبر / Lab Templates">
                    <field name="name" string="الاسم / Name"/>
                    <field name="code" string="الكود / Code"/>
                    <field name="department" string="القسم / Department"/>
                    <field name="sample_type" string="نوع العينة / Sample Type"/>
                    <field name="line_count" string="المعامل / Parameters"/>
                    <field name="turnaround_hours" string="مدة التنفيذ بالساعات / Turnaround Hours"/>
                    <field name="active" string="نشط / Active"/>
                </list>
            </field>
        </record>

        <!-- ── Action ── -->
        <record id="action_medical_lab_templates" model="ir.actions.act_window">
            <field name="name">قوالب المختبر / Lab Templates</field>
            <field name="res_model">medical.lab.template</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
