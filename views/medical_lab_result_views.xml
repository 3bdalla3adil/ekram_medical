<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ── Form View ── -->
        <record id="view_medical_lab_result_form" model="ir.ui.view">
            <field name="name">medical.lab.result.form</field>
            <field name="model">medical.lab.result</field>
            <field name="arch" type="xml">
                <form string="نتيجة مختبر / Lab Result">
                    <header>
                        <button class="btn-success" invisible="state != 'draft'" name="action_validate" string="اعتماد / Validate" type="object"/>
                        <button class="btn-info" icon="fa-print" invisible="state != 'validated'" name="action_print_report" string="طباعة التقرير / Print Report" type="object"/>
                        <button invisible="state in ['validated', 'cancelled']" name="action_cancel" string="إلغاء / Cancel" type="object"/>
                        <button invisible="state != 'cancelled'" name="action_reset_draft" string="إرجاع لمسودة / Reset" type="object"/>
                        <field name="state" statusbar_visible="draft,validated" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="المريض / Patient">
                                <field name="patient_id" readonly="1"/>
                                <field name="template_id"/>
                                <field name="request_id" readonly="1"/>
                            </group>
                            <group string="الطاقم الطبي / Staff">
                                <field name="doctor_id" readonly="1"/>
                                <field name="technician_id"/>
                                <field name="result_date"/>
                            </group>
                        </group>
                        <group invisible="validated_by == False" string="الاعتماد / Validation">
                            <field name="validated_by" readonly="1"/>
                            <field name="validated_date" readonly="1"/>
                        </group>
                        <notebook>
                            <page name="results" string="النتائج / Results">
                                <field name="line_ids">
                                    <list decoration-danger="flag == 'critical'" decoration-success="flag == 'normal'" decoration-warning="flag in ('high', 'low')" editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="test_name" readonly="1"/>
                                        <field name="result_value"/>
                                        <field name="unit" readonly="1"/>
                                        <field name="normal_range_text" readonly="1" string="النطاق المرجعي / Reference Range"/>
                                        <field decoration-danger="flag == 'critical'" decoration-success="flag == 'normal'" decoration-warning="flag in ('high', 'low')" name="flag" readonly="1" widget="badge"/>
                                        <field name="remarks"/>
                                    </list>
                                </field>
                            </page>
                            <page name="remarks" string="ملاحظات / Remarks">
                                <field name="remarks" placeholder="ملاحظات عامة / General remarks..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ── List View ── -->
        <record id="view_medical_lab_result_list" model="ir.ui.view">
            <field name="name">medical.lab.result.list</field>
            <field name="model">medical.lab.result</field>
            <field name="arch" type="xml">
                <list decoration-muted="state == 'cancelled'" decoration-success="state == 'validated'" string="نتائج المختبر / Lab Results">
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="template_id"/>
                    <field name="technician_id"/>
                    <field name="result_date"/>
                    <field decoration-muted="state == 'cancelled'" decoration-success="state == 'validated'" decoration-warning="state == 'draft'" name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- ── Action ── -->
        <record id="action_medical_lab_results" model="ir.actions.act_window">
            <field name="name">نتائج المختبر / Lab Results</field>
            <field name="res_model">medical.lab.result</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
