<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medical_consultation_form" model="ir.ui.view">
        <field name="name">medical.consultation.form</field>
        <field name="model">medical.consultation</field>
        <field name="arch" type="xml">
            <form string="الاستشارة / Consultation">
                <header>
                    <button class="btn-primary" invisible="state != 'draft'" name="action_start" string="بدء / Start" type="object"/>
                    <button class="btn-success" invisible="state != 'in_progress'" name="action_done" string="إكمال / Complete" type="object"/>
                    <button class="btn-info" invisible="state not in ['in_progress', 'done']" name="action_create_lab_request" string="طلب فحوصات مختبر / Request Lab Tests" type="object"/>
                    <button invisible="state != 'done'" name="action_create_invoice" string="إنشاء فاتورة / Create Invoice" type="object"/>
                    <button invisible="state in ['done', 'cancelled']" name="action_cancel" string="إلغاء / Cancel" type="object"/>
                    <field name="state" statusbar_visible="draft,in_progress,done" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-flask" name="action_create_lab_request" type="object">
                            <field name="lab_request_count" string="طلبات المختبر / Lab Requests" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="المريض / Patient">
                            <field name="patient_id" options="{'no_create': True}"/>
                            <field name="doctor_id" options="{'no_create': True,'no_open': True}"/>
                            <field name="appointment_id"/>
                        </group>
                        <group string="الجدول / Schedule">
                            <field name="consultation_date"/>
                            <field name="follow_up_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="clinical" string="ملاحظات سريرية / Clinical Notes">
                            <group>
                                <field name="chief_complaint" placeholder="الشكوى الرئيسية / Chief complaint..."/>
                                <field name="diagnosis" placeholder="التشخيص / Diagnosis..."/>
                                <field name="clinical_notes" placeholder="ملاحظات سريرية / Clinical notes..."/>
                            </group>
                        </page>
                        <page name="prescription" string="الوصفة الطبية / Prescription">
                            <field name="prescription" placeholder="أدخل تفاصيل الوصفة / Enter prescription details..."/>
                        </page>
                        <page name="followup" string="المتابعة / Follow-up">
                            <group>
                                <field name="follow_up_date"/>
                                <field name="follow_up_notes" placeholder="تعليمات المتابعة / Follow-up instructions..."/>
                            </group>
                        </page>
                        <page name="lab_requests" string="طلبات المختبر / Lab Requests">
                            <field name="lab_request_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="state" widget="badge"/>
                                    <field name="result_count" string="النتائج / Results"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medical_consultation_list" model="ir.ui.view">
        <field name="name">medical.consultation.list</field>
        <field name="model">medical.consultation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'done'" decoration-warning="state == 'in_progress'" string="الاستشارات / Consultations">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="consultation_date"/>
                <field name="diagnosis"/>
                <field decoration-muted="state == 'cancelled'" decoration-success="state == 'done'" decoration-warning="state == 'in_progress'" name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_medical_consultation_search" model="ir.ui.view">
        <field name="name">medical.consultation.search</field>
        <field name="model">medical.consultation</field>
        <field name="arch" type="xml">
            <search string="بحث الاستشارات / Search Consultations">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <separator/>
                <filter domain="[('consultation_date', '>=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')), ('consultation_date', '&lt;=', datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))]" name="filter_today" string="اليوم / Today"/>
                <filter domain="[('state', '=', 'in_progress')]" name="filter_in_progress" string="قيد التنفيذ / In Progress"/>
                <filter domain="[('state', '=', 'done')]" name="filter_done" string="منجز / Done"/>
                <group>
                    <filter context="{'group_by': 'doctor_id'}" name="group_doctor" string="الطبيب / Doctor"/>
                    <filter context="{'group_by': 'state'}" name="group_state" string="الحالة / Status"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medical_consultations" model="ir.actions.act_window">
        <field name="name">الاستشارات / Consultations</field>
        <field name="res_model">medical.consultation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Example menuitem (commented out) -->
    <!-- <menuitem id="menu_medical_consultation" name="الاستشارات / Consultations" parent="ekram_medical.menu_ekram_medical_root" action="action_medical_consultations" active="0" sequence="4"/> -->
</odoo>
