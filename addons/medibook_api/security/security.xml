<odoo>
  <record id="group_medibook_patient" model="res.groups"><field name="name">MediBook / Patient</field></record>
  <record id="group_medibook_doctor" model="res.groups"><field name="name">MediBook / Doctor</field></record>
  <record id="group_medibook_admin" model="res.groups"><field name="name">MediBook / Clinic Admin</field></record>
  <record id="group_medibook_billing" model="res.groups"><field name="name">MediBook / Billing</field></record>
  <record id="group_medibook_reception" model="res.groups"><field name="name">MediBook / Reception</field></record>
  <record id="rule_medibook_clinic_org" model="ir.rule">
    <field name="name">MediBook clinic organization isolation</field>
    <field name="model_id" ref="model_medibook_clinic"/>
    <field name="domain_force">[('organization_id','in',user.medibook_organization_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="rule_medibook_service_org" model="ir.rule">
    <field name="name">MediBook service organization isolation</field>
    <field name="model_id" ref="model_medibook_service"/>
    <field name="domain_force">[('clinic_id.organization_id','in',user.medibook_organization_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="rule_medibook_appointment_org" model="ir.rule">
    <field name="name">MediBook appointment organization isolation</field>
    <field name="model_id" ref="model_medibook_appointment"/>
    <field name="domain_force">[('clinic_id.organization_id','in',user.medibook_organization_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
</odoo>