<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ekram_medical.ReceptionDashboard">
        <div class="card shadow-sm">
            <div class="card-body" style="max-height:85vh; overflow-y:auto;">
                <t t-if="state.loading">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"/>
                        <p class="mt-2 text-muted">جاري تحميل لوحة الاستقبال / Loading dashboard...</p>
                    </div>
                </t>
                <t t-else="">
                    <!-- Header -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
                        <div class="mb-2">
                            <h3 class="mb-0 text-primary">
                                <i class="fa fa-hospital-o mr-2"/> لوحة الاستقبال / Reception Dashboard
                            </h3>
                            <small class="text-muted">مركز إكرام الطبي / Ekram Medical Center</small>
                            <div>
                                <small class="text-muted">Welcome, <strong>
                                    <t t-esc="this.state.user_name"/></strong>
                                </small>
                            </div>        
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" t-on-click="loadData">
                                <i class="fa fa-refresh"/> تحديث / Refresh
                            </button>
                            <a href="/web/session/logout" class="btn btn-danger btn-sm">
                                <i class="fa fa-sign-out"/> تسجيل الخروج / Logout
                            </a>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <h6 class="text-uppercase text-muted mb-3">إجراءات سريعة / Quick Actions</h6>
                    <div class="d-flex flex-wrap gap-2 mb-4 ">
                        <button class="btn btn-primary flex-fill kpi-card" t-on-click="openNewPatient">
                            <i class="fa fa-user-plus mr-1"/> مريض جديد / New Patient
                        </button>
                        <button class="btn btn-success flex-fill kpi-cardgf vjbm" t-on-click="openNewAppointment">
                            <i class="fa fa-calendar-plus-o mr-1"/> حجز موعد / Book Appointment
                        </button>
                    </div>

                    <div class="ekram_dash_header lab_header">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-primary kpi-card" t-on-click="openNewRequest">
                                    <i class="fa fa-plus"/> طلب جديد / New Request
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- KPI Cards -->
                    <div class="row mb-4">
                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-primary h-100 kpi-card">
                                <div class="card-body" t-on-click="openPatientList">
                                    <i class="fa fa-users fa-2x text-primary mb-2"/>
                                    <h4><t t-esc="state.kpis.patients_today || 0"/></h4>
                                    <p class="text-muted">مرضى اليوم / Patients Today</p>
                                    <small>الإجمالي / Total: <t t-esc="state.kpis.total_patients || 0"/></small>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-success h-100 kpi-card">
                                <div class="card-body" t-on-click="openAppointmentTodayList">
                                    <i class="fa fa-calendar-check-o fa-2x text-success mb-2"/>
                                    <h4><t t-esc="state.kpis.appointments_today || 0"/></h4>
                                    <p class="text-muted">مواعيد اليوم / Appointments Today</p>
                                    <small>قيد الانتظار / Pending: <t t-esc="state.kpis.pending_appointments || 0"/></small>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-warning h-100 kpi-card" t-on-click="openAllRequests">
                                <div class="card-body">
                                    <i class="fa fa-hourglass-half fa-2x text-warning mb-2"/>
                                    <h4><t t-esc="state.kpis.pending_requests || 0"/></h4>
                                    <p class="text-muted">طلبات معلقة / Pending Requests</p>
                                    <small>قيد التنفيذ / In Progress: <t t-esc="state.kpis.in_progress || 0"/></small>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-success h-100 kpi-card" t-on-click="openAllRequests">
                                <div class="card-body">
                                    <i class="fa fa-check-circle fa-2x text-success mb-2"/>
                                    <h4><t t-esc="state.kpis.completed_today || 0"/></h4>
                                    <p class="text-muted">مكتمل اليوم / Completed Today</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-info h-100 kpi-card" t-on-click="openAllResults">
                                <div class="card-body">
                                    <i class="fa fa-pencil-square-o fa-2x text-info mb-2"/>
                                    <h4><t t-esc="state.kpis.pending_results || 0"/></h4>
                                    <p class="text-muted">نتائج بحاجة للإدخال / Results to Enter</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-primary h-100 kpi-card" t-on-click="openAllRequests">
                                <div class="card-body">
                                    <i class="fa fa-spinner fa-spin fa-2x text-primary mb-2"/>
                                    <h4><t t-esc="state.kpis.in_progress || 0"/></h4>
                                    <p class="text-muted">قيد التنفيذ / In Progress</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-mute h-100 kpi-card" t-on-click="this.openNewInvoice">
                                <div class="card-body">
                                    <i class="fa fa-file-text-o text-primary mb-2"/>
                                    <h4><t t-esc="this.state.kpis.invoices_today || 0"/></h4>
                                    <p class="text-muted">فاتورة جديدة/New Invoice</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3 mb-3">
                            <div class="card text-center border-danger h-100 kpi-card" t-on-click="this.openOutstanding">
                                <div class="card-body">
                                    <i class="fa fa-exclamation-circle text-primary mb-2"/>
                                    <h4><t t-esc="this.state.kpis.outstanding || 0"/></h4>
                                    <p class="text-muted">مستحقات /Outstanding</p>
                                </div>
                            </div>
                        </div>
                        
                    </div>


                    <!-- Today's Appointments -->
                    <div class="card">
                        <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fa fa-calendar mr-2"/> مواعيد اليوم / Today's Appointments</h5>
                            <button class="btn btn-primary btn-sm mt-2 mt-sm-0" t-on-click="openNewAppointment">
                                <i class="fa fa-plus"/> جديد / New
                            </button>
                        </div>
                        <div class="card-body">
                            <t t-if="state.appointments.length === 0">
                                <div class="text-center py-5">
                                    <i class="fa fa-calendar-o fa-3x text-muted"/>
                                    <p class="text-muted mt-2">لا توجد مواعيد مجدولة لليوم / No appointments scheduled for today.</p>
                                    <button class="btn btn-primary btn-sm" t-on-click="openNewAppointment">
                                        احجز أول موعد / Book First Appointment
                                    </button>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>الوقت / Time</th><th>المريض / Patient</th><th>الطبيب / Doctor</th>
                                                <th>النوع / Type</th><th>الحالة / Status</th><th>الإجراء / Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="this.state.appointments" t-as="apt" t-key="apt.id">
                                                <tr t-on-click="() => this.viewAppointmentsById(apt.id)">
                                                    <td><strong><t t-esc="apt.time"/></strong></td>
                                                    <td><t t-esc="apt.patient"/></td>
                                                    <td><t t-esc="apt.doctor"/></td>
                                                    <td><span class="badge badge-light"><t t-esc="apt.type"/></span></td>
                                                    <td>
                                                        <span t-attf-class="#{getStateBadgeClass(apt.state)}">
                                                            <t t-esc="apt.state_label"/>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-outline-primary btn-sm"
                                                                >
                                                            <i class="fa fa-eye"/> فتح / Open
                                                        </button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>    
    </t>
</templates>
